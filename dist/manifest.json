{
  "manifest_version": 3,
  "name": "Woodhouse",
  "version": "0.1.0",
  "description": "DevTools traffic analyst: HTTP/WS capture, header & privacy analysis, duplicate detection, console and source summaries. All processing is local.",
  "minimum_chrome_version": "111",
  "devtools_page": "devtools.html",
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"]
}
